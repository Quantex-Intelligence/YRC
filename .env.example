# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5433/yrc_global"

# Authentication & Session Security
SESSION_SECRET="replace-with-a-random-32-byte-hex-secret-in-production"

# Server Environment
NODE_ENV="development"
PORT=3000

# Storage Provider (LOCAL or S3)
STORAGE_PROVIDER="LOCAL"
LOCAL_UPLOAD_DIR="var/uploads"

# Payment Provider (DEV_MOCK or RAZORPAY)
PAYMENT_PROVIDER="DEV_MOCK"
